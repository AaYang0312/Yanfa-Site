---
const { review = false } = Astro.props;
---
<form id="product-filter" class="grid"><label>搜索名称或型号<input name="q" type="search" maxlength="200" /></label><label>分类<select name="category" aria-label="分类"><option value="">全部分类</option></select></label><label>目标上下架<select name="visibility" aria-label="目标上下架"><option value="">全部状态</option><option value="listed">目标上架</option><option value="unlisted">目标下架</option></select></label><div class="actions"><button type="submit">搜索</button>{!review && <a class="button primary" href="/admin/products/new/">新建草稿</a>}</div></form>
<p class="muted">按排序值、稳定 ID 升序。目标状态和未发布修改分别展示；保存不会立即公开。</p>
<div id="products" data-review={review ? 'true' : 'false'} aria-live="polite"></div><button id="more-products" type="button" hidden>加载更多产品</button>
<script>
  import '../lib/products';
</script>
