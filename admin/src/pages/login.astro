---
import Admin from '../layouts/Admin.astro';
---
<Admin title="登录产品管理" login>
  <p class="login-intro">欢迎回来，继续维护元发产品资料。</p>
  <form id="login" class="login-panel"><label>用户名<input name="username" required autocomplete="username" maxlength="120" autofocus /></label><label>密码<input name="password" type="password" required autocomplete="current-password" /></label><button class="primary" type="submit">登录</button><p class="muted">请使用管理员账号登录。</p></form>
  <script>
    import { api, ApiError, notice, showError } from '../lib/api';
    import type { SessionResponse } from '../../../src/generated/contracts';
    const form = document.querySelector<HTMLFormElement>('#login')!;
    form.addEventListener('submit', async event => {
      event.preventDefault(); const submit = form.querySelector('button')!; submit.disabled = true; submit.textContent = '正在登录…';
      const data = new FormData(form);
      try {
        await api<SessionResponse>('/api/admin/login', { method: 'POST', body: JSON.stringify({ username: data.get('username'), password: data.get('password') }) });
        form.reset();
        const next = new URLSearchParams(location.search).get('next'); let target: URL | null = null;
        try { target = next ? new URL(next, location.origin) : null; } catch {}
        location.assign(target?.origin === location.origin && /^\/admin\/(products(?:\/|$)|settings(?:\/|$))/.test(target.pathname) ? target.href : '/admin/products/');
      } catch (error) { (form.elements.namedItem('password') as HTMLInputElement).value = ''; if (error instanceof ApiError && error.status === 401) notice('用户名或密码不正确，请重新输入。', true); else showError(error); }
      finally { submit.disabled = false; submit.textContent = '登录'; }
    });
  </script>
</Admin>
