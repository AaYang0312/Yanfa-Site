---
import '../styles/admin.css';
const { title, login = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>{title} · 元发内容管理</title></head>
  <body>
    <a class="skip" href="#main">跳到主要内容</a>
    <header class="topbar"><a class="brand" href="/admin/">元发 <span>内容管理</span></a>
      {!login && <><nav aria-label="后台导航"><a href="/admin/products/">产品</a><a href="/admin/media/">素材</a><a href="/admin/guide-reviews/">选型审核</a><a href="/admin/candidates/">候选版本</a><a href="/admin/publications/">发布与回退</a><a href="/admin/workbuddy/">WorkBuddy 接入</a></nav><button id="logout" type="button">退出</button></>}
    </header>
    <main id="main" tabindex="-1"><h1>{title}</h1>
      {!login && <p id="session-state" class="muted" aria-live="polite">正在检查管理会话…</p>}
      <div id="notice" role="status" aria-live="polite" tabindex="-1"></div>
      <slot />
    </main>
    <script>
      import { initSession } from '../lib/api';
      if (document.querySelector('#session-state')) initSession();
    </script>
  </body>
  <style is:global>
    .publication-meta{display:grid;grid-template-columns:minmax(6rem,auto) minmax(0,1fr);gap:.35rem 1rem;overflow-wrap:anywhere}
    .publication-meta dt{font-weight:600}.publication-meta dd{margin:0;min-width:0}
    .publication-json,.publication-change pre{white-space:pre-wrap;overflow-wrap:anywhere;max-width:100%;font-size:.88rem}
    .publication-thumbnail{display:block;max-width:100%;width:160px;height:120px;object-fit:contain}
    .publication-change>summary{overflow-wrap:anywhere}.publication-change .diff>div{min-width:0}
    #session-state{overflow-wrap:anywhere}
    @media(max-width:500px){.publication-meta{grid-template-columns:minmax(0,1fr)}.publication-meta dd{margin-bottom:.5rem}}
  </style>
</html>
