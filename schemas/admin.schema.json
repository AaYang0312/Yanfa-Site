{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanfa.example/schemas/admin.schema.json",
  "title": "ErrorResponse",
  "$ref": "#/$defs/ErrorResponse",
  "$defs": {
    "ErrorDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "current_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "maxItems": 1000
        }
      },
      "required": [
        "code",
        "message",
        "fields"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ]
    },
    "LoginInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "username",
        "password"
      ]
    },
    "SessionResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admin_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "csrf_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "workspace_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active_release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "admin_id",
        "username",
        "csrf_token",
        "expires_at",
        "workspace_revision",
        "active_release_id"
      ]
    },
    "AdminProductQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "category": {
          "$ref": "product.schema.json#/$defs/CategoryID"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "listed",
            "unlisted"
          ]
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "required": []
    },
    "ProductSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "category_id": {
          "$ref": "product.schema.json#/$defs/CategoryID"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "listed",
            "unlisted"
          ]
        },
        "sort_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "ever_published": {
          "type": "boolean"
        },
        "has_unpublished_changes": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "model",
        "category_id",
        "visibility",
        "sort_order",
        "version",
        "updated_at",
        "ever_published",
        "has_unpublished_changes"
      ]
    },
    "AdminProductList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active_release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductSummary"
          },
          "maxItems": 100
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "workspace_revision",
        "active_release_id",
        "items",
        "next_cursor"
      ]
    },
    "DeletionResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deleted_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "workspace_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "deleted_id",
        "workspace_revision"
      ]
    },
    "MediaQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "required": []
    },
    "MediaList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "catalog-snapshot.schema.json#/$defs/MediaRecord"
          },
          "maxItems": 100
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "items",
        "next_cursor",
        "after"
      ]
    },
    "OpenUploadInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": []
    },
    "OpenUploadResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upload_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "upload_url",
        "after"
      ]
    },
    "CandidateInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_workspace_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "expected_workspace_revision"
      ]
    },
    "CandidateState": {
      "type": "string",
      "enum": [
        "queued",
        "building",
        "ready",
        "failed"
      ]
    },
    "Change": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "before_json": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 262144
            },
            {
              "type": "null"
            }
          ]
        },
        "after_json": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 262144
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "product_id",
        "field",
        "before_json",
        "after_json"
      ]
    },
    "CandidateDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Change"
          },
          "maxItems": 100000
        },
        "affected_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]*$",
            "x-safe-relative-path": true
          },
          "maxItems": 100000,
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 10000
        }
      },
      "required": [
        "baseline_release_id",
        "changes",
        "affected_routes",
        "warnings"
      ]
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "state": {
          "$ref": "#/$defs/CandidateState"
        },
        "schema_version": {
          "type": "integer",
          "const": 1,
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "workspace_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "code_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_active_release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff": {
          "$ref": "#/$defs/CandidateDiff"
        },
        "workspace_changed": {
          "type": "boolean"
        },
        "preview_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "review_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "id",
        "state",
        "schema_version",
        "workspace_revision",
        "code_version",
        "snapshot_sha256",
        "expected_active_release_id",
        "created_at",
        "started_at",
        "completed_at",
        "error",
        "diff",
        "workspace_changed",
        "preview_url",
        "review_url"
      ]
    },
    "PreviewInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "candidate_id"
      ]
    },
    "PreviewSession": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "active"
      ]
    },
    "PublicationInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "publish",
            "rollback"
          ]
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_active_release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_workspace_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "candidate_id",
        "release_id",
        "snapshot_sha256",
        "expected_active_release_id",
        "expected_workspace_revision"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "publish"
              }
            }
          },
          "then": {
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "release_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "candidate_id": {
                "type": "null"
              },
              "release_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            }
          }
        }
      ]
    },
    "ConfirmationInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_active_release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_workspace_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "snapshot_sha256",
        "expected_active_release_id",
        "expected_workspace_revision"
      ]
    },
    "PublicationState": {
      "type": "string",
      "enum": [
        "awaiting_confirmation",
        "queued",
        "activating",
        "succeeded",
        "stale",
        "expired",
        "cancelled",
        "failed"
      ]
    },
    "PublicationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "publish",
            "rollback"
          ]
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_active_release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_workspace_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "$ref": "#/$defs/PublicationState"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "site_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "review_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "diff": {
          "$ref": "#/$defs/CandidateDiff"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "candidate_id",
        "release_id",
        "snapshot_sha256",
        "expected_active_release_id",
        "expected_workspace_revision",
        "state",
        "created_at",
        "expires_at",
        "confirmed_by",
        "confirmed_at",
        "completed_at",
        "result_release_id",
        "site_url",
        "review_url",
        "diff",
        "error"
      ]
    },
    "PublicationList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active_release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicationRequest"
          },
          "maxItems": 100
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "active_release_id",
        "items",
        "next_cursor"
      ]
    },
    "TokenScope": {
      "type": "string",
      "enum": [
        "products:read",
        "products:write",
        "media:read",
        "candidates:write",
        "publications:write"
      ]
    },
    "TokenInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenScope"
          },
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "expires_at",
        "scopes"
      ]
    },
    "TokenInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "revoked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenScope"
          },
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "created_at",
        "expires_at",
        "revoked_at",
        "scopes"
      ]
    },
    "TokenIssued": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/$defs/TokenInfo"
        },
        "secret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "token",
        "secret"
      ]
    },
    "TokenList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenInfo"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "items"
      ]
    },
    "HealthLive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ok",
          "type": "string"
        }
      },
      "required": [
        "status"
      ]
    },
    "HealthReady": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "database": {
          "type": "string",
          "enum": [
            "ready",
            "unavailable"
          ]
        },
        "artifacts": {
          "type": "string",
          "enum": [
            "ready",
            "unavailable",
            "uninitialized"
          ]
        },
        "model": {
          "type": "string",
          "enum": [
            "configured",
            "unconfigured"
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ready",
        "database",
        "artifacts",
        "model",
        "release_id"
      ]
    }
  }
}
