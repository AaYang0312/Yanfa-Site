      },
      "required": [
        "scene_ids",
        "materials",
        "substrates",
        "excluded_materials",
        "excluded_substrates",
        "power_source",
        "nail_type",
        "fastener_length_mm",
        "load_bearing",
        "long_nose",
        "blower",
        "limitations",
        "consultation_notes",
        "required_requirements",
        "sources",
        "reviews"
      ]
    },
    "PurchaseOptionEdit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
