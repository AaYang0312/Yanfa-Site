        },
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "category_id": {
          "$ref": "#/$defs/CategoryID"
        },
        "series": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "legacy_series_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "applications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "maxItems": 30
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "maxItems": 30
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "maxItems": 30
        },
        "scene_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SceneID"
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "nail_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/NailType"
            },
            {
              "type": "null"
            }
          ]
        },
        "fastener_text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "long_nose": {
          "type": "boolean"
        },
        "blower": {
          "type": "boolean"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductImage"
          },
          "maxItems": 12,
          "x-unique-by": "media_id"
        },
        "cover_media_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "type": "string",
          "enum": [
            "listed",
            "unlisted"
          ]
        },
        "sort_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "guide_profile": {
          "$ref": "#/$defs/GuideProfile"
        },
        "purchase_options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PurchaseOption"
          },
          "maxItems": 100,
          "x-unique-by": "id"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "slug",
        "kind",
        "name",
        "model",
        "category_id",
        "series",
        "legacy_series_ids",
        "summary",
        "applications",
        "features",
        "notes",
        "scene_ids",
        "nail_type",
        "fastener_text",
        "long_nose",
        "blower",
        "images",
        "cover_media_id",
        "visibility",
        "sort_order",
        "guide_profile",
        "purchase_options",
        "version",
        "updated_at"
      ],
      "x-cover-membership": true
    },
    "ProductEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "$ref": "#/$defs/ProductDocument"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "workspace_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "product",
        "version",
        "workspace_revision"
      ],
      "x-product-version": true
    },
    "GuideReviewInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "$ref": "#/$defs/GuideField"
              },
              "fact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_sha256s": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "maxItems": 100,
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "field",
              "fact_sha256",
              "source_sha256s"
            ]
          },
          "maxItems": 14,
          "x-unique-by": "field"
        }
      },
      "required": [
        "version",
        "facts"
      ]
    },
    "PublishedProduct": {
      "$ref": "#/$defs/ProductDocument",
      "allOf": [
        {
          "if": {
            "properties": {
              "visibility": {
                "const": "listed"
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "[^\\x09-\\x0d\\x20\\x85\\xa0  -     　]"
              },
              "purchase_options": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "match_scope": {
                            "const": "listing_with_variants"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "sku_hint": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500,
                            "pattern": "[^\\x09-\\x0d\\x20\\x85\\xa0  -     　]"
                          }
                        }
                      }
                    }
                  ],
                  "properties": {
                    "platform": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "store_name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://[^/@\\s]+(?:[/?#]|$)"
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "tool"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "model": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "[^\\x09-\\x0d\\x20\\x85\\xa0  -     　]"
                    },
                    "summary": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "pattern": "[^\\x09-\\x0d\\x20\\x85\\xa0  -     　]"
                    },
                    "applications": {
                      "$ref": "#/$defs/PublishedToolApplications"
                    },
                    "images": {
                      "type": "array",
                      "minItems": 1
                    },
                    "cover_media_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120,
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "PublishedToolApplications": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "minItems": 1,
      "maxItems": 30,
      "contains": {
        "type": "string",
        "pattern": "[^\\x09-\\x0d\\x20\\x85\\xa0  -     　]"
      }
    }
  }
}
