{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanfa.example/schemas/product.schema.json",
  "title": "ProductDocument",
  "$ref": "#/$defs/ProductDocument",
  "$defs": {
    "CategoryID": {
      "type": "string",
      "enum": [
        "straight",
        "steel",
        "staple",
        "pin",
        "coil",
        "remover",
        "insulation",
        "gas",
        "nails",
        "other"
      ]
    },
    "SceneID": {
      "type": "string",
      "enum": [
        "home-woodworking",
        "ceiling-framing",
        "packaging-pallets",
        "furniture-timber",
        "panel-fastening",
        "nail-removal",
        "wall-insulation",
        "electrical-plumbing",
        "wall-mesh",
        "upholstery-rattan"
      ]
    },
    "NailType": {
      "type": "string",
      "enum": [
        "brad",
        "steel-nail",
        "staple",
        "coil-nail",
        "pin",
        "insulation-nail",
        "gas-nail"
      ]
    },
    "RequirementField": {
      "type": "string",
      "enum": [
        "scene_ids",
        "material",
        "substrate",
        "nail_type",
        "fastener_length_mm",
        "air_supply",
        "load_bearing",
        "long_nose",
        "blower"
      ]
    },
    "PowerSource": {
      "type": "string",
      "enum": [
        "pneumatic",
        "gas",
        "electric",
        "manual"
      ]
    },
    "LengthRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1.7976931348623157e+308
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1.7976931348623157e+308
        }
      },
      "required": [
        "min",
        "max"
      ],
      "x-ordered-range": [
        "min",
        "max"
      ]
    },
    "ProductImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        }
      },
      "required": [
        "media_id",
        "label",
        "description"
      ]
    },
    "GuideSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "product_text",
            "media",
            "document"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "public_label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "public_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/@\\s]+(?:[/?#]|$)"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "reference",
        "sha256",
        "public_label",
        "public_url"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "product_text"
              }
            }
          },
          "then": {
            "properties": {
              "reference": {
                "type": "string",
                "pattern": "^/"
              }
            }
          },
          "else": {
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            }
          }
        }
      ]
    },
    "GuideField": {
      "type": "string",
      "enum": [
        "scene_ids",
        "materials",
        "substrates",
        "excluded_materials",
        "excluded_substrates",
        "power_source",
        "nail_type",
        "fastener_length_mm",
        "load_bearing",
        "long_nose",
        "blower",
        "limitations",
        "consultation_notes",
        "required_requirements"
      ]
    },
    "GuideReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/GuideField"
        },
        "fact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256s": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "maxItems": 100,
          "uniqueItems": true,
          "minItems": 1
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "field",
        "fact_sha256",
        "source_sha256s",
        "reviewed_by",
        "reviewed_at"
      ]
    },
    "GuideProfileEdit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scene_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SceneID"
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "substrates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "excluded_materials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "excluded_substrates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "power_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PowerSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "nail_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/NailType"
            },
            {
              "type": "null"
            }
          ]
        },
        "fastener_length_mm": {
          "anyOf": [
            {
              "$ref": "#/$defs/LengthRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "load_bearing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "long_nose": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "blower": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "maxItems": 30
        },
        "consultation_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "maxItems": 30
        },
        "required_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementField"
          },
          "maxItems": 9,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuideSource"
          },
          "maxItems": 100,
          "x-unique-by": "id"
        }
      },
      "required": [
        "scene_ids",
        "materials",
        "substrates",
        "excluded_materials",
        "excluded_substrates",
        "power_source",
        "nail_type",
        "fastener_length_mm",
        "load_bearing",
        "long_nose",
        "blower",
        "limitations",
        "consultation_notes",
        "required_requirements",
        "sources"
      ]
    },
