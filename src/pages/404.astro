---
import Base from '../layouts/Base.astro';
---

<Base title="页面不存在" contactStrip={false}>
  <section class="section">
    <div class="wrap missing">
      <p class="missing__code">404</p>
      <h1>页面不存在</h1>
      <p class="muted">链接可能已经调整。可以从首页或产品目录重新进入。</p>
      <div class="missing__actions">
        <a class="btn btn--solid" href="/">返回首页</a>
        <a class="btn" href="/products/">产品中心</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .missing {
    text-align: center;
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .missing__code {
    margin: 0;
    color: var(--wine);
    font-family: var(--font-latin);
    font-size: 96px;
    font-weight: 300;
    line-height: 1;
  }

  .missing h1 {
    margin: 16px 0 12px;
    font-size: 30px;
  }

  .missing__actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 32px;
  }
</style>
