---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import wechatVideo from '../assets/ppt/wechat-video.png';
import douyinNailgun from '../assets/ppt/douyin-nailgun.png';
import douyinTools from '../assets/ppt/douyin-tools.png';
import { media } from '../data/site';

const shots = {
  'wechat-video': wechatVideo,
  'douyin-nailgun': douyinNailgun,
  'douyin-tools': douyinTools,
};
---

<Base title="官方媒体" description="元发官方微信视频号与抖音号：元发YANFA五金工具、元发钉枪、元发工具。">
  <PageHead
    title="官方媒体"
    lead="看产品演示、施工视频和售后讲解。"
  />

  <section class="section section--paper">
    <div class="wrap">
      <p class="accounts__schedule">每晚直播</p>
      <ul class="accounts">
        {media.map((item) => (
          <li>
            <div class="accounts__identity">
              <p class="accounts__platform">{item.platform}</p>
              <h2>{item.name}</h2>
            </div>
            <figure class="accounts__figure">
              <div class="accounts__shot">
                <Image
                  src={shots[item.image]}
                  alt={`${item.platform}「${item.name}」主页截图`}
                  widths={[320, 640]}
                  sizes="(max-width: 640px) 80vw, 320px"
                />
              </div>
              <figcaption>账号主页截图</figcaption>
            </figure>
            <p class="accounts__bio">{item.bio}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .accounts__schedule {
    margin: 0 0 28px;
    color: var(--wine);
    font-weight: 500;
  }

  .accounts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .accounts > li { min-width: 0; }
  .accounts__identity { margin-bottom: 20px; }
  .accounts__figure { margin: 0 0 20px; }

  .accounts__shot {
    display: grid;
    place-items: start center;
    height: 520px;
    padding: 24px 24px 0;
    overflow: hidden;
    background: #fff;
    border-top: 3px solid var(--wine);
  }

  .accounts__shot img {
    display: block;
    width: 100%;
    max-width: 300px;
    height: auto;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
  }

  .accounts__figure figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13px;
  }

  .accounts__platform {
    margin: 0 0 6px;
    color: var(--navy);
    font-size: 14px;
  }

  .accounts h2 {
    margin: 0;
    color: var(--wine);
    font-size: 22px;
    overflow-wrap: anywhere;
  }

  .accounts__bio {
    margin: 0;
    color: var(--ink);
    font-size: 14px;
  }

  @media (max-width: 960px) {
    .accounts,
    .accounts__schedule {
      max-width: 420px;
      margin-right: auto;
      margin-left: auto;
    }

    .accounts { grid-template-columns: 1fr; }
  }
</style>
