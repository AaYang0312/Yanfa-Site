---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site, telHref } from '../data/site';

const inquiries = [
  { title: '产品选型', details: ['型号', '作业用途'] },
  { title: '采购报价', details: ['型号', '数量'] },
  { title: '批发合作', details: ['区域', '渠道类型'] },
];
---

<Base title="联系" description={`联系${site.name}：询价、选型与批发合作。`} contactStrip={false}>
  <PageHead title="联系" />

  <section class="section section--paper">
    <div class="wrap contact">
      <div class="contact__info">
        <h2>{site.legalName}</h2>
        <p>{site.brand} {site.brandEn}</p>
      </div>

      <div class="contact__phone">
        <p class="contact__label">咨询电话</p>
        <a class="contact__number" href={telHref()}>{site.phone}</a>
        <a class="btn btn--solid" href={telHref()}>拨打电话</a>
      </div>
    </div>
  </section>

  <section class="section" id="dealer" aria-labelledby="inquiries-heading">
    <div class="wrap inquiries">
      <h2 class="h-section" id="inquiries-heading">业务咨询</h2>
      <dl class="inquiries__list">
        {inquiries.map((item) => (
          <div>
            <dt>{item.title}</dt>
            <dd>{item.details.map((detail) => <span>{detail}</span>)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .contact,
  .inquiries {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
  }

  .contact__info h2 {
    margin-bottom: 24px;
    color: var(--wine);
    font-size: 22px;
  }

  .contact__info { min-width: 0; }
  .contact__info p { color: var(--ink); font-size: 14px; }

  .contact__phone {
    min-width: 0;
    padding: 40px;
    background: #fff;
    border-top: 3px solid var(--wine);
  }

  .contact__label {
    margin-bottom: 8px;
    font-size: 13px;
    color: var(--muted);
  }

  .contact__number {
    display: block;
    margin-bottom: 12px;
    color: var(--wine);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 500;
    text-decoration: none;
  }

  .contact__phone > .btn { margin-top: 12px; }

  .inquiries__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin: 0;
  }

  .inquiries__list dt {
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--wine);
    color: var(--navy);
    font-size: 18px;
    font-weight: 500;
  }

  .inquiries__list dd {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    color: var(--text);
  }

  @media (max-width: 960px) {
    .contact,
    .inquiries {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .contact__phone { padding: 24px 20px; }
  }

  @media (max-width: 640px) {
    .inquiries__list { grid-template-columns: 1fr; gap: 24px; }
    .inquiries__list dt { margin-bottom: 12px; }
  }
</style>
