---
interface Props {
  href: string;
  model: string;
  subtitle: string;
  lines: { label: string; value: string }[];
  badge?: string;
  data?: Record<string, string>;
}

const { href, model, subtitle, lines, badge, data = {} } = Astro.props;
const attrs = Object.fromEntries(Object.entries(data).map(([key, value]) => [`data-${key}`, value]));
---

<article class="card" data-card {...attrs}>
  <a class="card__media" href={href} tabindex="-1" aria-hidden="true">
    <slot />
    {badge && <span class="card__badge">{badge}</span>}
  </a>
  <a class="card__head" href={href}>
    <h3>{model}</h3>
    <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M3 1.5 6.5 5 3 8.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
  </a>
  <p class="card__sub">{subtitle}</p>
  <dl>
    {lines.map((line) => (
      <div>
        <dt>{line.label}：</dt>
        <dd>{line.value}</dd>
      </div>
    ))}
  </dl>
</article>

<style>
  .card[hidden] {
    display: none;
  }

  .card__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 12px;
    margin-bottom: 18px;
    background: #f3f4f5;
    overflow: hidden;
  }

  .card__media :global(svg),
  .card__media :global(img) {
    transition: transform 0.45s ease;
  }

  .card:hover .card__media :global(svg),
  .card:hover .card__media :global(img) {
    transform: scale(1.05);
  }

  .card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 2px 10px;
    background: var(--wine);
    color: #fff;
    font-size: 12px;
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--wine);
    text-decoration: none;
  }

  .card__head h3 {
    color: var(--wine);
    font-size: 19px;
    font-weight: 600;
  }

  .card__head svg {
    width: 12px;
    height: 12px;
  }

  .card__sub {
    margin: 4px 0 0;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  dl {
    margin: 12px 0 0;
    font-size: 13px;
  }

  dl div {
    display: flex;
    gap: 4px;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    color: var(--navy);
    font-weight: 600;
  }

  dl div { align-items: baseline; }
  dt { flex: none; }
  dd { min-width: 0; overflow-wrap: anywhere; }
  @media (prefers-reduced-motion: reduce) {
    .card__media :global(svg), .card__media :global(img) { transition: none; }
  }
</style>
