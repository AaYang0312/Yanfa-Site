---
interface Option {
  value: string;
  label: string;
}

interface Group {
  name: string;
  label: string;
  options: Option[];
}

interface Props {
  title: string;
  groups: Group[];
  typeNames: Record<string, string>;
}

const { title, groups, typeNames } = Astro.props;
---

<div class="catalog" data-catalog data-type-names={JSON.stringify(typeNames)}>
  <aside class="catalog__side">
    <h2 class="catalog__side-title">筛选</h2>
    <form data-filter-form id="catalog-filters">
      {groups.map((group, index) => (
        <details open={index === 0}>
          <summary>{group.label}</summary>
          <ul>
            {group.options.map((option) => (
              <li>
                <label>
                  <input type="checkbox" name={group.name} value={option.value} />
                  <span>{option.label}</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
      ))}
      <button class="btn catalog__reset" type="reset">清除筛选（<span data-filter-count>0</span>）</button>
    </form>
  </aside>

  <div class="catalog__main">
    <div class="title-bar"><h1 data-catalog-title>{title}</h1></div>
    <div class="catalog__tools">
      <label class="catalog__search">
        <span class="sr-only">搜索型号、系列或功能</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.4" /></svg>
        <input type="search" name="q" form="catalog-filters" placeholder="搜索型号、系列或功能" autocomplete="off" data-catalog-search />
      </label>
      <p class="catalog__result" role="status" aria-live="polite">找到 <strong data-result-count>0</strong> 项产品</p>
    </div>
    <div class="catalog__grid">
      <slot />
    </div>
    <div class="catalog__empty" data-empty hidden>
      <p>暂无匹配产品</p>
      <button type="reset" form="catalog-filters" class="btn">清除全部条件</button>
    </div>
    <slot name="after" />
  </div>
</div>

<style>
  .catalog {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 64px;
    padding-bottom: 96px;
  }

  .catalog__side-title {
    padding-bottom: 18px;
    font-size: 22px;
    font-weight: 600;
    border-bottom: 2px solid var(--wine);
  }

  .catalog__main { min-width: 0; }

  .catalog__tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin: -12px 0 32px;
  }

  .catalog__search {
    display: flex;
    gap: 10px;
    align-items: center;
    width: min(100%, 360px);
    padding: 10px 14px;
    border: 1px solid var(--line);
  }

  .catalog__search:focus-within { border-color: var(--wine); }
  .catalog__search svg { width: 18px; height: 18px; flex: none; color: var(--wine); }
  .catalog__search input {
    width: 100%;
    height: auto;
    min-width: 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--ink);
  }
  .catalog__search input:focus-visible { outline: none; }
  .catalog__result { margin: 0; color: var(--text); font-size: 13px; }
  .catalog__result strong { color: var(--wine); font-size: 18px; font-weight: 500; }

  .catalog__side {
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    padding: 15px 0;
    color: var(--ink);
    font-size: 14px;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-size: 18px;
    line-height: 1;
  }

  details[open] summary::after {
    content: '−';
  }

  details ul {
    margin: 0;
    padding: 0 0 14px;
    list-style: none;
  }

  label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 0;
    font-size: 14px;
    cursor: pointer;
  }

  input {
    width: 15px;
    height: 15px;
    accent-color: var(--wine);
  }

  .catalog__reset {
    width: 100%;
    margin-top: 28px;
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px 32px;
  }

  .catalog__empty {
    padding: 40px 0;
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .catalog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 960px) {
    .catalog {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .catalog__side {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .catalog__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
