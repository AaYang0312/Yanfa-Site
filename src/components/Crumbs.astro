---
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="面包屑">
  <ol class="crumbs">
    <li><a href="/">首页</a></li>
    {items.map((item) =>
      item.href ? (
        <li><a href={item.href}>{item.label}</a></li>
      ) : (
        <li aria-current="page">{item.label}</li>
      ),
    )}
  </ol>
</nav>
