---
interface Props { name?: string }
const { name = '产品' } = Astro.props;
---
<span class="product-placeholder" role="img" aria-label={`${name}：暂无实物图`}>
  <svg viewBox="0 0 48 16" width="48" height="16" aria-hidden="true" focusable="false" fill="currentColor">
    <circle cx="8" cy="8" r="3" />
    <circle cx="24" cy="8" r="3" />
    <circle cx="40" cy="8" r="3" />
  </svg>
</span>
<style>
  .product-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; min-width: 0; min-height: 0; background: var(--paper, #f4f4f4); color: var(--navy, #1c3350); }
  .product-placeholder svg { display: block; flex: none; width: min(48px, 60%); height: auto; opacity: .4; }
</style>
