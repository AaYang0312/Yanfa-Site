---
import Crumbs from './Crumbs.astro';
import ProductImage from './ProductImage.astro';
import ProductGallery from './ProductGallery.astro';
import { products, categories, categoryBySlug, productsIn, nailOf, nailName, scenesOf, type Product } from '../data/catalog';
import { telHref } from '../data/site';

interface Props { product: Product }
const { product } = Astro.props;
const category = categoryBySlug(product.category);
const nail = nailOf(product);
const isTool = product.kind === 'tool';
const applicationsLabel = product.kind === 'consumable' ? '适用工具与用途' : '适用场景';
const specs = [
  { label: '产品类型', value: category.name },
  ...(product.series ? [{ label: '所属系列', value: product.series }] : []),
  ...(product.fastener ? [{ label: '适用枪钉', value: product.fastener.replace(/\n/g, ' ') }] : []),
  ...(scenesOf(product).length ? [{ label: '适用场景', value: scenesOf(product).join('、') }] : []),
];
const matchingCategory = product.category === 'nails' ? categories.find((item) => item.nail === product.nail) : undefined;
const matchedGuns = matchingCategory ? productsIn(matchingCategory.slug) : [];
const nailItem = isTool ? products.find((item) => item.category === 'nails' && item.nail === nail) : undefined;
const siblings = productsIn(product.category).filter((item) => item.slug !== product.slug);
const related = (siblings.length ? siblings : products.filter((item) => item.kind === 'tool' && item.category !== product.category)).slice(0, 4);
---

<div class="wrap detail">
  <div class="detail__crumbs">
    <Crumbs items={[{ label: '产品中心', href: '/products/' }, { label: category.name, href: `/products/?type=${category.slug}` }, { label: product.name }]} />
  </div>
  <div class="detail__top">
    {product.images.length > 0 ? <ProductGallery product={product} /> : (
      <div class="detail__media">
        <ProductImage product={product} />
      </div>
    )}
    <div class="detail__info">
      <p class="detail__kicker">
        {category.name}
        {product.longNose && <span class="detail__new">加长枪嘴</span>}
        {product.blower && <span class="detail__new">打钉 + 吹尘</span>}
      </p>
      <h1>{product.name}</h1>
      <p class="detail__name">{product.summary}</p>
      <dl class="specs">
        {specs.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}
      </dl>
      {product.features.length > 0 && (
        <ul class="detail-highlights">
          {product.features.slice(0, 3).map((feature) => <li>{feature}</li>)}
        </ul>
      )}
      <nav class="detail__actions" aria-label="购买与咨询">
        <a class="btn btn--solid" href={telHref()}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 3 3 5-3 3c1 2 3 4 5 5l3-3 5 3v3c0 1-1 2-2 2C10 20 4 14 3 5c0-1 1-2 2-2z" /></svg>型号与配件咨询</a>
        <a class="btn" href="/shop/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 12H4L5 8Zm3 0V6a4 4 0 0 1 8 0v2" /></svg>价格与库存</a>
      </nav>
    </div>
  </div>
</div>

{(product.features.length > 0 || product.applications.length > 0 || product.notes.length > 0 || related.length > 0) && (
  <>
    <nav class="detail-nav" aria-label="产品信息章节">
      <div class="wrap">
        {product.features.length > 0 && <a href="#features">产品特点</a>}
        {product.applications.length > 0 && <a href="#applications">{applicationsLabel}</a>}
        {product.notes.length > 0 && <a href="#usage">使用说明</a>}
        {related.length > 0 && <a href="#related">相关型号</a>}
      </div>
    </nav>
    {product.features.length > 0 && (
      <section class="section section--paper" id="features">
        <div class="wrap detail__grid">
          <h2 class="h-section">产品特点</h2>
          <ul class="detail-content">{product.features.map((feature) => <li>{feature}</li>)}</ul>
        </div>
      </section>
    )}
    {product.applications.length > 0 && <section class="section" id="applications">
      <div class="wrap detail__grid">
        <h2 class="h-section">{applicationsLabel}</h2>
        <div class="application-copy">
          {product.applications.map((text) => <p>{text.replace(/^\d+[.、]/, '')}</p>)}
        </div>
      </div>
    </section>}
    {product.notes.length > 0 && (
      <section class="section section--paper" id="usage">
        <div class="wrap detail__grid">
          <h2 class="h-section">使用说明<br />与注意事项</h2>
          <div class="usage-copy">
            {product.notes.map((text) => <p>{text.replace(/^\d+[.、]/, '')}</p>)}
          </div>
        </div>
      </section>
    )}
  </>
)}

{(matchedGuns.length > 0 || nailItem) && (
  <section class="section">
    <div class="wrap detail__grid">
      <h2 class="h-section">{nailItem ? '浏览枪钉' : '浏览工具'}</h2>
      <nav class="matched" aria-label={nailItem ? '枪钉分类导航' : '工具分类导航'}>
        {nailItem && (
          <a class="matched__item" href={`/products/${nailItem.slug}/`}>
            <span class="matched__art" aria-hidden="true"><ProductImage product={nailItem} thumbnail sizes="120px" /></span>
            <span><strong>{nailItem.name}</strong><small>{nailName(nail)}</small></span>
          </a>
        )}
        {matchedGuns.map((item) => (
          <a class="matched__item" href={`/products/${item.slug}/`}>
            <span class="matched__art" aria-hidden="true"><ProductImage product={item} thumbnail sizes="120px" /></span>
            <span><strong>{item.name}</strong><small>{item.fastener}</small></span>
          </a>
        ))}
      </nav>
    </div>
  </section>
)}

{related.length > 0 && <section class="section related" id="related">
  <div class="wrap">
    <div class="title-bar"><h2>{siblings.length ? category.slug === 'other' ? '同类产品' : `其他${category.name}` : '更多产品'}</h2></div>
    <ul class="related__list">
      {related.map((item) => (
        <li>
          <a href={`/products/${item.slug}/`}>
            <span class="related__art" aria-hidden="true"><ProductImage product={item} sizes="(max-width: 960px) 45vw, 25vw" /></span>
            <strong>{item.name}</strong><small>{item.summary}</small>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>}

<style>
  .detail__actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .detail__actions .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding-right: 16px; padding-left: 16px; }
  .detail__actions svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .matched { min-width: 0; }
  .matched__item { min-width: 0; gap: 16px; }
  .matched__item > span:last-child { min-width: 0; overflow-wrap: anywhere; }
  .matched__art { width: clamp(64px, 20vw, 120px); }
  @media (max-width: 380px) { .detail__actions { grid-template-columns: 1fr; } }
  .detail-highlights { padding-left: 18px; margin: 0 0 28px; color: var(--navy); font-size: 14px; }
  .detail-highlights li { margin-bottom: 6px; }
  .detail-nav { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .detail-nav .wrap { display: flex; flex-wrap: wrap; gap: 16px 36px; padding-top: 18px; padding-bottom: 18px; }
  .detail-nav a { color: var(--wine); text-decoration: none; font-size: 14px; }
  .detail-nav a:hover { text-decoration: underline; }
  .detail-content { margin: 0; padding: 0; list-style: none; }
  .detail-content li { padding: 16px 0; border-bottom: 1px solid #d9dbde; color: var(--navy); }
  .detail-content li:first-child { padding-top: 0; }
  .application-copy, .usage-copy { min-width: 0; overflow-wrap: anywhere; color: var(--ink); }
  .application-copy p { padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .usage-copy p:last-child, .application-copy p:last-child { margin-bottom: 0; }
</style>
